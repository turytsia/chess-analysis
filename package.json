{
  "name": "chess-analysis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copyEngineAssets.mjs",
    "start": "vite",
    "prebuild": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --cache --cache-strategy content --max-warnings 0 src --fix",
    "lint:check": "eslint --cache --cache-strategy content --max-warnings 0 src",
    "lint:unused": "knip && node scripts/checkExports.mjs",
    "format:code": "prettier --parser typescript \"*.{ts,mjs,cjs}\" \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx}\"",
    "format:check": "pnpm format:code --list-different",
    "format": "pnpm format:code --write",
    "openings:build": "node scripts/buildOpeningBook.mjs"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "10.30.0"
  },
  "packageManager": "pnpm@10.30.0",
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "chess.js": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "coi-serviceworker": "0.1.7",
    "date-fns": "4.4.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "i18next": "27.1.1",
    "lucide-react": "1.72.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-chessboard": "5.12.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "stockfish": "19.0.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.32.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "knip": "6.45.1",
    "prettier": "2.8.8",
    "tailwindcss": "4.3.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.30.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
